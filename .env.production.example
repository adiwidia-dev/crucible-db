APP_NAME="Crucible DB"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crucible.example.com

NATIVE_PROXY_ENABLED=false
NATIVE_PROXY_CONTROL_SECRET=
NATIVE_PROXY_MAX_CONNECTIONS=100
NATIVE_PROXY_MAX_CONNECTIONS_PER_LEASE=3
NATIVE_PROXY_MAX_CONNECTIONS_PER_USER=10
NATIVE_PROXY_MAX_PENDING_DEVICE_AUTHORIZATIONS_PER_LEASE=3
NATIVE_PROXY_CONNECTION_STALE_SECONDS=60
NATIVE_PROXY_STATEMENT_STALE_SECONDS=900
NATIVE_PROXY_IDLE_TIMEOUT=15m
NATIVE_PROXY_DRAIN_TIMEOUT=30s
NATIVE_PROXY_READINESS_INTERVAL=5s

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=FULL
DB_TRANSACTION_MODE=IMMEDIATE

LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Shared by Laravel and the native proxy for immediate lease-revocation signals.
NATIVE_PROXY_REVOCATION_CHANNEL=native-proxy:lease-revoked
NATIVE_PROXY_HEALTH_URL=http://native-proxy:8081/readyz
NATIVE_PROXY_EXPECTED_VERSION=
NATIVE_PROXY_CLI_DOWNLOAD_URL=https://github.com/adiwidia-dev/crucible-db/releases/latest

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_WORKERS=2
OCTANE_MAX_REQUESTS=500
