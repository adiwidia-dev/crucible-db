FROM node:25-bookworm-slim AS node

FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader \
    --ignore-platform-req=ext-pcntl \
    --no-scripts

FROM dunglas/frankenphp:1-php8.5 AS frontend

WORKDIR /app

COPY --from=node /usr/local /usr/local

# Vite invokes Wayfinder, which boots Laravel while generating typed routes.
# This key is only used in this disposable build stage.
ENV APP_ENV=production \
    DB_DATABASE=/app/storage/database/crucible.sqlite

COPY --from=vendor /app/vendor /app/vendor
COPY package.json package-lock.json ./

RUN npm ci

COPY . ./

RUN mkdir -p \
        /app/storage/database \
        /app/storage/framework/cache \
        /app/storage/framework/sessions \
        /app/storage/framework/views \
        /app/storage/logs \
    && touch /app/storage/database/crucible.sqlite \
    && APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= php artisan package:discover --ansi --no-interaction \
    && APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= php artisan wayfinder:generate --with-form --no-interaction \
    && APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= npm run build

FROM dunglas/frankenphp:1-php8.5 AS production

WORKDIR /app

ARG CRUCIBLE_VERSION=dev
ARG CRUCIBLE_REVISION=unknown

LABEL org.opencontainers.image.title="Crucible DB" \
    org.opencontainers.image.description="A governed control plane for reviewed, scheduled, and auditable database access." \
    org.opencontainers.image.source="https://github.com/adiwidia-dev/crucible-db" \
    org.opencontainers.image.url="https://adiwidia-dev.github.io/crucible-db/" \
    org.opencontainers.image.documentation="https://adiwidia-dev.github.io/crucible-db/" \
    org.opencontainers.image.version="${CRUCIBLE_VERSION}" \
    org.opencontainers.image.revision="${CRUCIBLE_REVISION}" \
    org.opencontainers.image.licenses="MIT"

RUN install-php-extensions \
    pcntl \
    pdo_mysql \
    pdo_pgsql \
    redis \
    zip

RUN apt-get update \
    && apt-get install -y --no-install-recommends supervisor \
    && rm -rf /var/lib/apt/lists/*

COPY --from=vendor /app/vendor /app/vendor
COPY . ./
COPY --from=frontend /app/public/build /app/public/build
COPY .docker/Caddyfile /etc/caddy/Caddyfile
COPY .docker/production-entrypoint.sh /usr/local/bin/crucible-production-entrypoint
COPY .docker/production-supervisord.conf /etc/supervisor/conf.d/crucible.conf

RUN chmod +x /usr/local/bin/crucible-production-entrypoint

ENTRYPOINT ["crucible-production-entrypoint"]
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/crucible.conf"]
